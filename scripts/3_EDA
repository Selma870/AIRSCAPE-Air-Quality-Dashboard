
# ============================================================
# GELAR RASA 2026
# TAHAP 3.1 - DATA OVERVIEW
# ============================================================

library(tidyverse)
library(lubridate)
library(readr)
library(writexl)

# 1. Pilih folder HASIL_DATA_AUDIT

folder_output <- choose.dir(
  caption = "Pilih folder HASIL_DATA_AUDIT"
)

if (is.na(folder_output)) {
  stop("Folder belum dipilih!")
}

# 2. Membaca data hasil Tahap 2

aqms_analysis <- read_csv(
  file.path(
    folder_output,
    "AQMS_Analysis_Valid.csv"
  ),
  show_col_types = FALSE
)

health_clean <- read_csv(
  file.path(
    folder_output,
    "Health_Clean.csv"
  ),
  show_col_types = FALSE
)

# 3. Memastikan format tanggal

aqms_analysis <- aqms_analysis %>%
  mutate(
    timestamp_start = ymd_hms(
      timestamp_start,
      quiet = TRUE
    ),
    tanggal = as.Date(timestamp_start)
  )

health_clean <- health_clean %>%
  mutate(
    date = as.Date(date)
  )


# ============================================================
# A. OVERVIEW DATASET
# ============================================================

overview_data <- tibble(
  
  komponen = c(
    "Jumlah data AQMS",
    "Jumlah stasiun AQMS",
    "Jumlah data Health",
    "Jumlah rumah sakit",
    "Tanggal awal AQMS",
    "Tanggal akhir AQMS",
    "Tanggal awal Health",
    "Tanggal akhir Health"
  ),
  
  hasil = c(
    nrow(aqms_analysis),
    n_distinct(aqms_analysis$station_file),
    nrow(health_clean),
    n_distinct(health_clean$hospital_id),
    as.character(min(aqms_analysis$tanggal, na.rm = TRUE)),
    as.character(max(aqms_analysis$tanggal, na.rm = TRUE)),
    as.character(min(health_clean$date, na.rm = TRUE)),
    as.character(max(health_clean$date, na.rm = TRUE))
  )
)

print(overview_data)


# ============================================================
# B. JUMLAH PENGAMATAN PER STASIUN
# ============================================================

overview_stasiun <- aqms_analysis %>%
  count(
    station_file,
    name = "jumlah_data"
  ) %>%
  arrange(desc(jumlah_data))

print(overview_stasiun, n = Inf)


# ============================================================
# C. KELOMPOK SATUAN
# ============================================================

overview_satuan <- aqms_analysis %>%
  group_by(station_file) %>%
  summarise(
    jumlah_ug_m3 = sum(!is.na(pm25_ug_m3)),
    jumlah_ppm = sum(!is.na(pm25_ppm)),
    .groups = "drop"
  ) %>%
  mutate(
    satuan = case_when(
      jumlah_ug_m3 > 0 ~ "ug/m3",
      jumlah_ppm > 0 ~ "ppm",
      TRUE ~ "Tidak tersedia"
    )
  )

print(overview_satuan, n = Inf)


# ============================================================
# D. CAKUPAN DATA PER BULAN
# ============================================================

cakupan_bulanan <- aqms_analysis %>%
  mutate(
    bulan = floor_date(
      timestamp_start,
      unit = "month"
    )
  ) %>%
  count(
    station_file,
    bulan,
    name = "jumlah_pengamatan"
  )

print(head(cakupan_bulanan, 20))


# ============================================================
# E. TREN KESEHATAN PER BULAN
# ============================================================

tren_health <- health_clean %>%
  mutate(
    bulan = floor_date(
      date,
      unit = "month"
    )
  ) %>%
  group_by(bulan) %>%
  summarise(
    
    ispa_lansia = sum(
      resp_admissions_over60,
      na.rm = TRUE
    ),
    
    asma = sum(
      asthma_emergency_cases,
      na.rm = TRUE
    ),
    
    copd = sum(
      copd_admissions,
      na.rm = TRUE
    ),
    
    gangguan_pernapasan_umum = sum(
      resp,
      na.rm = TRUE
    ),
    
    .groups = "drop"
  )

print(tren_health)


# ============================================================
# F. EKSPOR HASIL EDA 3.1
# ============================================================

hasil_eda_31 <- list(
  
  "Overview_Data" = overview_data,
  
  "Jumlah_Per_Stasiun" = overview_stasiun,
  
  "Kelompok_Satuan" = overview_satuan,
  
  "Cakupan_Bulanan" = cakupan_bulanan,
  
  "Tren_Health" = tren_health
)

write_xlsx(
  hasil_eda_31,
  file.path(
    folder_output,
    "Hasil_EDA_Bagian_3_1.xlsx"
  )
)

cat("EDA 3.1 berhasil disimpan!")


# ============================================================
# DIAGNOSTIK TIMESTAMP EDA 3.1
# ============================================================

# 1. Periksa tipe data timestamp

class(aqms_analysis$timestamp_start)

# 2. Periksa jumlah timestamp kosong

sum(is.na(aqms_analysis$timestamp_start))

# 3. Periksa baris yang tanggalnya tidak terbaca

aqms_analysis %>%
  filter(is.na(timestamp_start)) %>%
  select(
    station_file,
    sensor_id,
    timestamp_start
  ) %>%
  head(20)

# 4. Periksa data tanggal 31 Desember 2023

aqms_analysis %>%
  filter(
    as.Date(timestamp_start) ==
      as.Date("2023-12-31")
  ) %>%
  count(station_file)

# 5. Periksa rentang waktu per stasiun

aqms_analysis %>%
  group_by(station_file) %>%
  summarise(
    tanggal_awal = min(
      as.Date(timestamp_start),
      na.rm = TRUE
    ),
    tanggal_akhir = max(
      as.Date(timestamp_start),
      na.rm = TRUE
    ),
    jumlah_timestamp_kosong =
      sum(is.na(timestamp_start)),
    .groups = "drop"
  )



# ============================================================
# GELAR RASA 2026
# TAHAP 3.2 - TEMPORAL ANALYSIS
# ============================================================

library(tidyverse)
library(lubridate)
library(readr)
library(writexl)

# ------------------------------------------------------------
# 1. MENYIAPKAN DATA
# ------------------------------------------------------------

# Gunakan objek aqms_analysis hasil validasi timestamp

# Membuat variabel waktu UTC

aqms_temporal <- aqms_analysis %>%
  mutate(
    waktu = timestamp_start,
    tanggal = as.Date(waktu),
    jam = hour(waktu),
    hari = wday(
      waktu,
      label = TRUE,
      abbr = FALSE,
      week_start = 1
    ),
    bulan = month(
      waktu,
      label = TRUE,
      abbr = FALSE
    ),
    bulan_angka = month(waktu),
    tahun = year(waktu)
  )

# ------------------------------------------------------------
# 2. MEMERIKSA KELOMPOK SATUAN
# ------------------------------------------------------------

# Analisis konsentrasi PM2.5 dalam ug/m3
# Tidak mencampurkan data ppm

aqms_temporal_ug <- aqms_temporal %>%
  filter(!is.na(pm25_ug_m3))

# ------------------------------------------------------------
# 3. POLA KONSENTRASI BERDASARKAN JAM
# ------------------------------------------------------------

pola_jam <- aqms_temporal_ug %>%
  group_by(jam) %>%
  summarise(
    rata_pm25 = mean(
      pm25_ug_m3,
      na.rm = TRUE
    ),
    median_pm25 = median(
      pm25_ug_m3,
      na.rm = TRUE
    ),
    jumlah_data = n(),
    .groups = "drop"
  )

print(pola_jam)

grafik_jam <- ggplot(
  pola_jam,
  aes(x = jam, y = rata_pm25)
) +
  geom_line(linewidth = 1) +
  geom_point(size = 2) +
  scale_x_continuous(
    breaks = 0:23
  ) +
  labs(
    title = "Pola Rata-rata PM2.5 Berdasarkan Jam",
    x = "Jam (UTC)",
    y = "Rata-rata PM2.5 (ug/m3)"
  ) +
  theme_minimal()

print(grafik_jam)

# ------------------------------------------------------------
# 4. POLA KONSENTRASI BERDASARKAN HARI
# ------------------------------------------------------------

pola_hari <- aqms_temporal_ug %>%
  group_by(hari) %>%
  summarise(
    rata_pm25 = mean(
      pm25_ug_m3,
      na.rm = TRUE
    ),
    median_pm25 = median(
      pm25_ug_m3,
      na.rm = TRUE
    ),
    jumlah_data = n(),
    .groups = "drop"
  )

print(pola_hari)

grafik_hari <- ggplot(
  pola_hari,
  aes(x = hari, y = rata_pm25)
) +
  geom_col() +
  labs(
    title = "Rata-rata PM2.5 Berdasarkan Hari",
    x = "Hari",
    y = "Rata-rata PM2.5 (ug/m3)"
  ) +
  theme_minimal()

print(grafik_hari)

# ------------------------------------------------------------
# 5. TREN BULANAN
# ------------------------------------------------------------

tren_bulanan <- aqms_temporal_ug %>%
  mutate(
    periode = floor_date(
      waktu,
      unit = "month"
    )
  ) %>%
  group_by(periode) %>%
  summarise(
    rata_pm25 = mean(
      pm25_ug_m3,
      na.rm = TRUE
    ),
    median_pm25 = median(
      pm25_ug_m3,
      na.rm = TRUE
    ),
    jumlah_data = n(),
    .groups = "drop"
  )

print(tren_bulanan)

grafik_bulanan <- ggplot(
  tren_bulanan,
  aes(x = periode, y = rata_pm25)
) +
  geom_line(linewidth = 0.8) +
  geom_point(size = 1.5) +
  labs(
    title = "Tren Bulanan Rata-rata PM2.5",
    x = "Bulan",
    y = "Rata-rata PM2.5 (ug/m3)"
  ) +
  theme_minimal()

print(grafik_bulanan)

# ------------------------------------------------------------
# 6. TREN TAHUNAN
# ------------------------------------------------------------

tren_tahunan <- aqms_temporal_ug %>%
  group_by(tahun) %>%
  summarise(
    rata_pm25 = mean(
      pm25_ug_m3,
      na.rm = TRUE
    ),
    median_pm25 = median(
      pm25_ug_m3,
      na.rm = TRUE
    ),
    jumlah_data = n(),
    .groups = "drop"
  )

print(tren_tahunan)

# ------------------------------------------------------------
# 7. WAKTU DENGAN KONSENTRASI TERTINGGI
# ------------------------------------------------------------

pm25_tertinggi <- aqms_temporal_ug %>%
  arrange(desc(pm25_ug_m3)) %>%
  select(
    station_file,
    waktu,
    pm25_ug_m3
  ) %>%
  slice_head(n = 20)

print(pm25_tertinggi)

# ------------------------------------------------------------
# 8. RINGKASAN POLA TEMPORAL PER STASIUN
# ------------------------------------------------------------

pola_stasiun <- aqms_temporal_ug %>%
  group_by(station_file) %>%
  summarise(
    rata_pm25 = mean(
      pm25_ug_m3,
      na.rm = TRUE
    ),
    median_pm25 = median(
      pm25_ug_m3,
      na.rm = TRUE
    ),
    maksimum_pm25 = max(
      pm25_ug_m3,
      na.rm = TRUE
    ),
    jumlah_data = n(),
    .groups = "drop"
  ) %>%
  arrange(desc(rata_pm25))

print(pola_stasiun, n = Inf)

# ------------------------------------------------------------
# 9. MENYIMPAN HASIL
# ------------------------------------------------------------

hasil_eda_32 <- list(
  "Pola_Jam" = pola_jam,
  "Pola_Hari" = pola_hari,
  "Tren_Bulanan" = tren_bulanan,
  "Tren_Tahunan" = tren_tahunan,
  "PM25_Tertinggi" = pm25_tertinggi,
  "Pola_Per_Stasiun" = pola_stasiun
)

write_xlsx(
  hasil_eda_32,
  file.path(
    folder_output,
    "Hasil_EDA_Bagian_3_2.xlsx"
  )
)

ggsave(
  file.path(
    folder_output,
    "Grafik_Pola_Jam_PM25.png"
  ),
  grafik_jam,
  width = 10,
  height = 6,
  dpi = 300
)

ggsave(
  file.path(
    folder_output,
    "Grafik_Tren_Bulanan_PM25.png"
  ),
  grafik_bulanan,
  width = 10,
  height = 6,
  dpi = 300
)

cat("\nEDA 3.2 berhasil disimpan!\n")


# ============================================================
# VALIDASI LONJAKAN PM2.5 OKTOBER 2026
# ============================================================

# 1. Ringkasan PM2.5 pada 14 Oktober 2026
# per stasiun

lonjakan_14okt <- aqms_temporal_ug %>%
  filter(
    tanggal == as.Date("2026-10-14")
  ) %>%
  group_by(station_file) %>%
  summarise(
    jumlah_data = sum(!is.na(pm25_ug_m3)),
    rata_pm25 = mean(pm25_ug_m3, na.rm = TRUE),
    median_pm25 = median(pm25_ug_m3, na.rm = TRUE),
    maksimum_pm25 = max(pm25_ug_m3, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  arrange(desc(rata_pm25))

print(lonjakan_14okt, n = Inf)


# 2. Bandingkan Oktober 2026
# sebelum dan sesudah 14 Oktober

perbandingan_oktober <- aqms_temporal_ug %>%
  filter(
    tahun == 2026,
    bulan_angka == 10
  ) %>%
  mutate(
    kelompok = if_else(
      tanggal == as.Date("2026-10-14"),
      "14 Oktober",
      "Selain 14 Oktober"
    )
  ) %>%
  group_by(kelompok) %>%
  summarise(
    jumlah_data = n(),
    rata_pm25 = mean(pm25_ug_m3, na.rm = TRUE),
    median_pm25 = median(pm25_ug_m3, na.rm = TRUE),
    maksimum_pm25 = max(pm25_ug_m3, na.rm = TRUE),
    .groups = "drop"
  )

print(perbandingan_oktober)


# 3. Tren bulanan dengan median
# untuk melihat pola yang tidak terlalu
# dipengaruhi nilai ekstrem

tren_median <- aqms_temporal_ug %>%
  group_by(periode = floor_date(waktu, "month")) %>%
  summarise(
    median_pm25 = median(pm25_ug_m3, na.rm = TRUE),
    rata_pm25 = mean(pm25_ug_m3, na.rm = TRUE),
    jumlah_data = n(),
    .groups = "drop"
  )

# 4. Grafik perbandingan mean dan median

tren_median_long <- tren_median %>%
  pivot_longer(
    cols = c(rata_pm25, median_pm25),
    names_to = "ukuran",
    values_to = "konsentrasi"
  )

grafik_validasi <- ggplot(
  tren_median_long,
  aes(
    x = periode,
    y = konsentrasi,
    color = ukuran
  )
) +
  geom_line(linewidth = 0.9) +
  geom_point(size = 1.5) +
  labs(
    title = "Perbandingan Mean dan Median PM2.5",
    x = "Bulan",
    y = "PM2.5 (ug/m3)",
    color = "Ukuran statistik"
  ) +
  theme_minimal()

print(grafik_validasi)


# 5. Simpan hasil validasi

write_xlsx(
  list(
    "Lonjakan_14_Oktober" = lonjakan_14okt,
    "Perbandingan_Oktober" = perbandingan_oktober,
    "Tren_Mean_Median" = tren_median
  ),
  file.path(
    folder_output,
    "Validasi_Lonjakan_PM25.xlsx"
  )
)


# ============================================================
# ANALISIS LANJUTAN: POLA HARIAN AGUSTUS-OKTOBER 2026
# ============================================================

# 1. Ringkasan PM2.5 per hari dan stasiun

harian_pm25 <- aqms_temporal_ug %>%
  
  filter(
    tanggal >= as.Date("2026-08-01"),
    tanggal <= as.Date("2026-10-14")
  ) %>%
  
  group_by(
    station_file,
    tanggal
  ) %>%
  
  summarise(
    
    rata_pm25 = mean(
      pm25_ug_m3,
      na.rm = TRUE
    ),
    
    median_pm25 = median(
      pm25_ug_m3,
      na.rm = TRUE
    ),
    
    maksimum_pm25 = max(
      pm25_ug_m3,
      na.rm = TRUE
    ),
    
    jumlah_pengamatan = n(),
    
    .groups = "drop"
  )

# 2. Tren harian gabungan

tren_harian <- harian_pm25 %>%
  
  group_by(tanggal) %>%
  
  summarise(
    
    rata_pm25 = mean(
      rata_pm25,
      na.rm = TRUE
    ),
    
    median_pm25 = median(
      rata_pm25,
      na.rm = TRUE
    ),
    
    jumlah_stasiun = n(),
    
    .groups = "drop"
  )

print(tren_harian, n = 20)


# 3. Grafik tren harian

grafik_harian <- ggplot(
  tren_harian,
  aes(
    x = tanggal,
    y = rata_pm25
  )
) +
  
  geom_line() +
  
  labs(
    title = "Tren Harian PM2.5 Agustus-Oktober 2026",
    x = "Tanggal",
    y = "Rata-rata PM2.5 (ug/m3)"
  ) +
  
  theme_minimal()

print(grafik_harian)


# 4. Periksa Palangka Raya dan Sampit

dua_stasiun <- harian_pm25 %>%
  
  filter(
    str_detect(
      station_file,
      "PalangkaRaya|Sampit"
    )
  )

grafik_dua_stasiun <- ggplot(
  dua_stasiun,
  aes(
    x = tanggal,
    y = rata_pm25,
    color = station_file
  )
) +
  
  geom_line(linewidth = 0.8) +
  
  labs(
    title = "Perbandingan Tren PM2.5 Palangka Raya dan Sampit",
    x = "Tanggal",
    y = "Rata-rata PM2.5 (ug/m3)",
    color = "Stasiun"
  ) +
  
  theme_minimal()

print(grafik_dua_stasiun)


# 5. Simpan hasil

write_xlsx(
  list(
    "PM25_Harian_Per_Stasiun" = harian_pm25,
    "Tren_Harian_Gabungan" = tren_harian,
    "PalangkaRaya_Sampit" = dua_stasiun
  ),
  file.path(
    folder_output,
    "Analisis_Lanjutan_PM25_Harian.xlsx"
  )
)

ggsave(
  file.path(
    folder_output,
    "Grafik_PM25_Harian.png"
  ),
  grafik_harian,
  width = 11,
  height = 6,
  dpi = 300
)

ggsave(
  file.path(
    folder_output,
    "Grafik_PalangkaRaya_Sampit.png"
  ),
  grafik_dua_stasiun,
  width = 11,
  height = 6,
  dpi = 300
)


# ============================================================
# INVESTIGASI ANOMALI PALANGKA RAYA DAN SAMPIT
# ============================================================

# 1. Ambil data kedua stasiun dari data mentah

cek_dua_stasiun <- aqms_raw %>%
  filter(
    str_detect(
      station_file,
      "PalangkaRaya|Sampit"
    )
  ) %>%
  mutate(
    tanggal = as.Date(
      ymd_hms(
        timestamp_start,
        quiet = TRUE
      )
    )
  ) %>%
  filter(
    tanggal >= as.Date("2026-08-01"),
    tanggal <= as.Date("2026-10-14")
  )

# 2. Ringkasan seluruh polutan per bulan

ringkasan_polutan <- cek_dua_stasiun %>%
  mutate(
    bulan = floor_date(
      ymd_hms(timestamp_start, quiet = TRUE),
      unit = "month"
    )
  ) %>%
  group_by(
    station_file,
    bulan
  ) %>%
  summarise(
    PM25 = mean(
      as.numeric(pm25_ug_m3),
      na.rm = TRUE
    ),
    PM10 = mean(
      as.numeric(pm10_ug_m3),
      na.rm = TRUE
    ),
    SO2 = mean(
      as.numeric(so2_ug_m3),
      na.rm = TRUE
    ),
    CO = mean(
      as.numeric(co_ug_m3),
      na.rm = TRUE
    ),
    O3 = mean(
      as.numeric(o3_ug_m3),
      na.rm = TRUE
    ),
    NO2 = mean(
      as.numeric(no2_ug_m3),
      na.rm = TRUE
    ),
    jumlah_data = n(),
    .groups = "drop"
  )

print(ringkasan_polutan, n = Inf)


# 3. Periksa distribusi PM2.5 per bulan

distribusi_pm25 <- cek_dua_stasiun %>%
  mutate(
    bulan = floor_date(
      ymd_hms(timestamp_start, quiet = TRUE),
      unit = "month"
    ),
    pm25 = as.numeric(pm25_ug_m3)
  ) %>%
  group_by(
    station_file,
    bulan
  ) %>%
  summarise(
    minimum = min(pm25, na.rm = TRUE),
    Q1 = quantile(pm25, 0.25, na.rm = TRUE),
    median = median(pm25, na.rm = TRUE),
    Q3 = quantile(pm25, 0.75, na.rm = TRUE),
    maksimum = max(pm25, na.rm = TRUE),
    simpangan_baku = sd(pm25, na.rm = TRUE),
    jumlah_data = sum(!is.na(pm25)),
    .groups = "drop"
  )

print(distribusi_pm25, n = Inf)


# 4. Periksa QC flag per bulan

cek_qc_bulanan <- cek_dua_stasiun %>%
  mutate(
    bulan = floor_date(
      ymd_hms(timestamp_start, quiet = TRUE),
      unit = "month"
    )
  ) %>%
  count(
    station_file,
    bulan,
    qc_flag
  )

print(cek_qc_bulanan, n = Inf)


# 5. Simpan hasil investigasi

write_xlsx(
  list(
    "Ringkasan_Polutan" = ringkasan_polutan,
    "Distribusi_PM25" = distribusi_pm25,
    "QC_Bulanan" = cek_qc_bulanan
  ),
  file.path(
    folder_output,
    "Investigasi_Anomali_Palangka_Sampit.xlsx"
  )
)


# ============================================================
# TAHAP INVESTIGASI LANJUTAN
# PALANGKA RAYA DAN SAMPIT
# ============================================================

library(tidyverse)
library(lubridate)
library(writexl)

# 1. Ambil data kedua stasiun

data_investigasi <- aqms_raw %>%
  filter(
    str_detect(
      station_file,
      "PalangkaRaya|Sampit"
    )
  ) %>%
  mutate(
    waktu = ymd_hms(
      timestamp_start,
      tz = "UTC",
      quiet = TRUE
    ),
    tanggal = as.Date(waktu),
    pm25 = as.numeric(pm25_ug_m3),
    pm10 = as.numeric(pm10_ug_m3),
    co = as.numeric(co_ug_m3)
  ) %>%
  filter(
    tanggal >= as.Date("2026-08-01"),
    tanggal <= as.Date("2026-10-14")
  )


# 2. Bandingkan data semua QC dan hanya VALID

perbandingan_qc <- data_investigasi %>%
  filter(
    !is.na(pm25)
  ) %>%
  group_by(
    station_file,
    bulan = floor_date(waktu, "month"),
    qc_flag
  ) %>%
  summarise(
    jumlah = n(),
    rata_pm25 = mean(pm25, na.rm = TRUE),
    median_pm25 = median(pm25, na.rm = TRUE),
    rata_pm10 = mean(pm10, na.rm = TRUE),
    rata_co = mean(co, na.rm = TRUE),
    .groups = "drop"
  )

print(perbandingan_qc, n = Inf)


# 3. Periksa perubahan nilai di sekitar
# 1 September dan 1 Oktober

cek_titik_perubahan <- data_investigasi %>%
  filter(
    tanggal >= as.Date("2026-08-30"),
    tanggal <= as.Date("2026-10-02")
  ) %>%
  filter(
    tanggal %in% as.Date(c(
      "2026-08-31",
      "2026-09-01",
      "2026-09-02",
      "2026-09-30",
      "2026-10-01",
      "2026-10-02"
    ))
  ) %>%
  group_by(
    station_file,
    tanggal
  ) %>%
  summarise(
    rata_pm25 = mean(pm25, na.rm = TRUE),
    rata_pm10 = mean(pm10, na.rm = TRUE),
    rata_co = mean(co, na.rm = TRUE),
    jumlah_data = n(),
    .groups = "drop"
  )

print(cek_titik_perubahan, n = Inf)


# 4. Periksa apakah sensor berubah

perubahan_sensor <- data_investigasi %>%
  group_by(
    station_file,
    sensor_id
  ) %>%
  summarise(
    tanggal_awal = min(tanggal, na.rm = TRUE),
    tanggal_akhir = max(tanggal, na.rm = TRUE),
    jumlah_data = n(),
    .groups = "drop"
  )

print(perubahan_sensor, n = Inf)


# 5. Simpan hasil

write_xlsx(
  list(
    "Perbandingan_QC" = perbandingan_qc,
    "Titik_Perubahan" = cek_titik_perubahan,
    "Pergantian_Sensor" = perubahan_sensor
  ),
  file.path(
    folder_output,
    "Investigasi_Lanjutan_Polusi.xlsx"
  )
)



# ============================================================
# PEMERIKSAAN LONJAKAN ANTARSTASIUN DI KALIMANTAN
# ============================================================

# 1. Pilih stasiun Kalimantan

stasiun_kalimantan <- aqms_raw %>%
  filter(
    str_detect(
      station_file,
      "PalangkaRaya|Sampit|PangkalanBun|Sintang|Samarinda|Banjarbaru|Banjarmasin"
    )
  ) %>%
  mutate(
    waktu = ymd_hms(
      timestamp_start,
      tz = "UTC",
      quiet = TRUE
    ),
    tanggal = as.Date(waktu),
    pm25 = as.numeric(pm25_ug_m3)
  )

# 2. Hitung rata-rata per stasiun
# pada tanggal sekitar perubahan

perbandingan_kalimantan <- stasiun_kalimantan %>%
  filter(
    tanggal %in% as.Date(c(
      "2026-08-31",
      "2026-09-01",
      "2026-09-02",
      "2026-09-30",
      "2026-10-01",
      "2026-10-02"
    ))
  ) %>%
  group_by(
    station_file,
    tanggal
  ) %>%
  summarise(
    rata_pm25 = mean(
      pm25,
      na.rm = TRUE
    ),
    jumlah_data = sum(!is.na(pm25)),
    .groups = "drop"
  ) %>%
  arrange(station_file, tanggal)

print(
  perbandingan_kalimantan,
  n = Inf
)

# 3. Simpan hasil

write_xlsx(
  list(
    "Perbandingan_Kalimantan" =
      perbandingan_kalimantan
  ),
  file.path(
    folder_output,
    "Pemeriksaan_Lonjakan_Kalimantan.xlsx"
  )
)



