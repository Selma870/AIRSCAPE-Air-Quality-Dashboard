pm25_daily <- aqms_daily_overall %>%
  filter(
    polutan == "pm25",
    satuan == "ug_m3"
  ) %>%
  arrange(tanggal)

# Hitung persentil ke-90
ambang_pm25 <- quantile(
  pm25_daily$rata_rata_polusi,
  probs = 0.90,
  na.rm = TRUE
)

# Lihat nilai ambang dan ringkasan data
ambang_pm25
summary(pm25_daily$rata_rata_polusi)

# Periksa jumlah stasiun yang tersedia
summary(pm25_daily$jumlah_stasiun)

pm25_episode <- pm25_daily %>%
  mutate(
    episode = rata_rata_polusi > as.numeric(ambang_pm25)
  ) %>%
  mutate(
    kelompok = cumsum(
      episode != lag(episode, default = first(episode))
    )
  ) %>%
  filter(episode) %>%
  group_by(kelompok) %>%
  summarise(
    tanggal_mulai = min(tanggal),
    tanggal_selesai = max(tanggal),
    durasi_hari = n(),
    konsentrasi_puncak = max(rata_rata_polusi),
    konsentrasi_rata_rata = mean(rata_rata_polusi),
    .groups = "drop"
  ) %>%
  arrange(tanggal_mulai)

# Periksa hasil episode
head(pm25_episode, 10)
dim(pm25_episode)

# Periksa pola PM2.5 selama episode terpanjang
validasi_episode <- data_harian_final %>%
  filter(
    polutan == "pm25",
    satuan == "ug_m3",
    tanggal >= as.Date("2026-08-01"),
