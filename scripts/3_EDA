audit_tanggal_muaro <- data_gas_27 %>%
  filter(stasiun == "JMB-02_MuaroJambi_AQMS") %>%
  mutate(
    waktu = ymd_hms(timestamp_start, quiet = TRUE),
    tanggal_bermasalah = is.na(waktu) |
      as.Date(waktu) < as.Date("2024-01-01") |
      as.Date(waktu) > as.Date("2026-10-14")
  ) %>%
  summarise(
    total_data = n(),
    tanggal_bermasalah = sum(tanggal_bermasalah),
    tanggal_normal = sum(!tanggal_bermasalah),
    valid_dengan_tanggal_bermasalah =
      sum(qc_flag == "VALID" & tanggal_bermasalah,
          na.rm = TRUE)
  )

print(audit_tanggal_muaro)
