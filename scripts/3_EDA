  group_by(stasiun) %>%
  summarise(
    jumlah_pengamatan = sum(!is.na(pm25_ug_m3)),
    rata_rata = mean(pm25_ug_m3, na.rm = TRUE),
    median = median(pm25_ug_m3, na.rm = TRUE),
    standar_deviasi = sd(pm25_ug_m3, na.rm = TRUE),
    minimum = min(pm25_ug_m3, na.rm = TRUE),
    maksimum = max(pm25_ug_m3, na.rm = TRUE),
    .groups = "drop"
  )

print(ringkasan_pm25)

