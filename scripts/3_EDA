  data <- data_aqms_list[[stasiun]]
  
  kolom_pm <- intersect(
    c("pm25_ug_m3", "pm25_ppm"),
    names(data)
  )[1]
  
  nilai_asli <- data[[kolom_pm]]
  nilai_num <- suppressWarnings(
    as.numeric(nilai_asli)
  )
  
  cat("\n============================\n")
  cat("STASIUN:", stasiun, "\n")
  cat("============================\n")
  
  # Data gagal dikonversi
  cat("\nContoh data gagal konversi:\n")
  
  print(
    data %>%
      mutate(nilai_num = nilai_num) %>%
      filter(
        !is.na(.data[[kolom_pm]]),
        is.na(nilai_num)
      ) %>%
      select(
        timestamp_start,
        all_of(kolom_pm),
        qc_flag
      ) %>%
      head(10)
  )
  
  # Nilai negatif dan tidak hingga
  cat("\nContoh nilai negatif atau Inf:\n")
  
  print(
    data %>%
      mutate(nilai_num = nilai_num) %>%
      filter(
        !is.na(nilai_num),
        nilai_num < 0 | !is.finite(nilai_num)
      ) %>%
      select(
        timestamp_start,
        all_of(kolom_pm),
        qc_flag
      ) %>%
      head(10)
  )
}

