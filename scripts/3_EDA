  filter(
    as.Date(timestamp_start) >= as.Date("2026-10-01"),
    as.Date(timestamp_start) <= as.Date("2026-10-14")
  ) %>%
  group_by(station_file, tanggal = as.Date(timestamp_start)) %>%
  summarise(
    rata_rata = mean(pm25_ug_m3, na.rm = TRUE),
    median = median(pm25_ug_m3, na.rm = TRUE),
    maksimum = max(pm25_ug_m3, na.rm = TRUE),
    minimum = min(pm25_ug_m3, na.rm = TRUE),
    jumlah_data = n(),
    .groups = "drop"
  )

print(cek_seluruh_stasiun, n = Inf)

aqms_analysis %>%
  filter(
    str_detect(station_file, "PalangkaRaya|Sampit"),
    as.Date(timestamp_start) >= as.Date("2026-10-10")
  ) %>%
  group_by(station_file, tanggal = as.Date(timestamp_start)) %>%
  summarise(
    PM25 = mean(pm25_ug_m3, na.rm = TRUE),
    PM10 = mean(pm10_ug_m3, na.rm = TRUE),
    SO2 = mean(so2_ug_m3, na.rm = TRUE),
    CO = mean(co_ug_m3, na.rm = TRUE),
    O3 = mean(o3_ug_m3, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  print(n = Inf)

cek_seluruh_stasiun <- aqms_analysis %>%
  filter(
    as.Date(timestamp_start) >= as.Date("2026-10-01"),
    as.Date(timestamp_start) <= as.Date("2026-10-14")
  ) %>%
  group_by(
    station_file,
    tanggal = as.Date(timestamp_start)
  ) %>%
  summarise(
    jumlah_pengamatan = n(),
    jumlah_pm25_tersedia = sum(!is.na(pm25_ug_m3)),
    
    rata_rata = ifelse(
      sum(!is.na(pm25_ug_m3)) > 0,
      mean(pm25_ug_m3, na.rm = TRUE),
      NA_real_
    ),
    
    median = ifelse(
      sum(!is.na(pm25_ug_m3)) > 0,
      median(pm25_ug_m3, na.rm = TRUE),
      NA_real_
    ),
    
    maksimum = ifelse(
      sum(!is.na(pm25_ug_m3)) > 0,
      max(pm25_ug_m3, na.rm = TRUE),
      NA_real_
    ),
    
    minimum = ifelse(
      sum(!is.na(pm25_ug_m3)) > 0,
      min(pm25_ug_m3, na.rm = TRUE),
      NA_real_
    ),
    
    .groups = "drop"
  )

print(cek_seluruh_stasiun, n = Inf)

cek_interval <- aqms_analysis %>%
  arrange(station_file, timestamp_start) %>%
  group_by(station_file) %>%
  mutate(
    selisih_menit = as.numeric(
      difftime(
        timestamp_start,
        lag(timestamp_start),
        units = "mins"
      )
    )
  ) %>%
  summarise(
    jumlah_data = n(),
    median_interval_menit = median(
      selisih_menit,
      na.rm = TRUE
    ),
    interval_minimum = min(
      selisih_menit,
      na.rm = TRUE
    ),
    interval_maksimum = max(
      selisih_menit,
      na.rm = TRUE
    ),
    .groups = "drop"
  )

print(cek_interval, n = Inf)

cek_missing_pm25 <- aqms_analysis %>%
  group_by(station_file) %>%
  summarise(
    total_data = n(),
    data_pm25_tersedia = sum(!is.na(pm25_ug_m3)),
    data_pm25_kosong = sum(is.na(pm25_ug_m3)),
    persentase_kosong = mean(is.na(pm25_ug_m3)) * 100,
    .groups = "drop"
  )

print(cek_missing_pm25, n = Inf)

