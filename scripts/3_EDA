pm25_network <- data_harian_final %>%
  filter(
    polutan == "pm25",
    satuan == "ug_m3"
  ) %>%
  group_by(tanggal) %>%
  summarise(
    rata_rata_jaringan = mean(nilai_rata_rata, na.rm = TRUE),
    median_jaringan = median(nilai_rata_rata, na.rm = TRUE),
    maksimum_jaringan = max(nilai_rata_rata, na.rm = TRUE),
    minimum_jaringan = min(nilai_rata_rata, na.rm = TRUE),
    jumlah_stasiun = n_distinct(stasiun),
    stasiun_diatas_100 = sum(nilai_rata_rata > 100, na.rm = TRUE),
    .groups = "drop"
  )

# Ambang P90 berdasarkan median jaringan
ambang_median <- quantile(
  pm25_network$median_jaringan,
  0.90,
  na.rm = TRUE
)

ambang_median

# Ringkasan hasil
summary(pm25_network$median_jaringan)

pm25_episode_median <- pm25_network %>%
  mutate(
    episode = median_jaringan > as.numeric(ambang_median)
  ) %>%
  mutate(
    kelompok = cumsum(
      episode != lag(episode, default = first(episode))
    )
  ) %>%
  filter(episode) %>%
  group_by(kelompok) %>%
  summarise(
    tanggal_mulai = min(tanggal),
    tanggal_selesai = max(tanggal),
    durasi_hari = n(),
    median_puncak = max(median_jaringan),
    median_rata_rata = mean(median_jaringan),
    rata_rata_puncak = max(rata_rata_jaringan),
    .groups = "drop"
  )

print(pm25_episode_median, n = Inf)

