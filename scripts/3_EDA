hasil_pm25_ekstrem <- purrr::imap_dfr(
  data_aqms_list,
  function(data, nama_stasiun) {
    
    kolom_pm <- intersect(
      c("pm25_ug_m3", "pm25_ppm"),
      names(data)
    )[1]
    
    if (is.na(kolom_pm)) return(NULL)
    
    data %>%
      mutate(
        pm25_num = as.numeric(.data[[kolom_pm]]),
        stasiun = nama_stasiun
      ) %>%
      filter(
        qc_flag == "VALID",
        !is.na(pm25_num)
      ) %>%
      arrange(desc(pm25_num)) %>%
      slice_head(n = 20) %>%
      select(stasiun, timestamp_start, qc_flag, pm25_num)
  }
)

hasil_pm25_ekstrem %>%
  arrange(desc(pm25_num)) %>%
  print(n = 30)

audit_konversi <- purrr::imap_dfr(
  data_aqms_list,
  function(data, nama_stasiun) {
    
    kolom_pm <- intersect(
      c("pm25_ug_m3", "pm25_ppm"),
      names(data)
    )[1]
    
    if (is.na(kolom_pm)) return(NULL)
    
    nilai_asli <- data[[kolom_pm]]
    nilai_num <- suppressWarnings(as.numeric(nilai_asli))
    
    tibble(
      stasiun = nama_stasiun,
      kolom = kolom_pm,
      jumlah_gagal = sum(
        !is.na(nilai_asli) & is.na(nilai_num)
      )
    )
  }
)

audit_konversi %>%
  filter(jumlah_gagal > 0) %>%
  print(n = Inf)

