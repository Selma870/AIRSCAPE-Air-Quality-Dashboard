# Periksa distribusi status QC seluruh 27 stasiun
ringkasan_qc_27 <- imap_dfr(
  data_aqms_list,
  function(x, nama_stasiun) {
    x %>%
      count(qc_flag) %>%
      mutate(stasiun = nama_stasiun)
  }
)

print(ringkasan_qc_27, n = Inf)

ringkasan_persentase_qc <- ringkasan_qc_27 %>%
  group_by(stasiun) %>%
  summarise(
    total_data = sum(n),
    data_valid = sum(n[qc_flag == "VALID"]),
    data_nonvalid = total_data - data_valid,
    persentase_valid = data_valid / total_data * 100,
    persentase_nonvalid = 100 - persentase_valid,
    .groups = "drop"
  ) %>%
  arrange(desc(persentase_valid))

print(ringkasan_persentase_qc, n = Inf)

ggplot(
  ringkasan_persentase_qc,
  aes(
    x = reorder(stasiun, persentase_valid),
    y = persentase_valid
  )
) +
  geom_col(fill = "steelblue") +
