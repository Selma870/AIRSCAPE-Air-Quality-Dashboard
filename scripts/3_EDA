  filter(qc_flag == "VALID")

# Memeriksa jumlah data setelah penyaringan

data_gas_valid %>%
  group_by(stasiun) %>%
  summarise(
    jumlah_data = n(),
    missing_so2 = sum(is.na(so2_ppm)),
    missing_no2 = sum(is.na(no2_ppm)),
    nol_so2 = sum(so2_ppm == 0, na.rm = TRUE),
    nol_no2 = sum(no2_ppm == 0, na.rm = TRUE),
    .groups = "drop"
  )

ringkasan_gas_valid <- data_gas_valid %>%
  group_by(stasiun) %>%
  summarise(
    n = n(),
    SO2_min = min(so2_ppm, na.rm = TRUE),
    SO2_mean = mean(so2_ppm, na.rm = TRUE),
    SO2_max = max(so2_ppm, na.rm = TRUE),
    NO2_min = min(no2_ppm, na.rm = TRUE),
    NO2_mean = mean(no2_ppm, na.rm = TRUE),
    NO2_max = max(no2_ppm, na.rm = TRUE),
    .groups = "drop"
  )

print(ringkasan_gas_valid, n = Inf)

