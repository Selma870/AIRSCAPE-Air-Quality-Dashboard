library(readr)
library(dplyr)

kolom_polutan <- c(
  "pm25_ug_m3",
  "pm10_ug_m3",
  "so2_ug_m3",
  "co_ug_m3",
  "o3_ug_m3",
  "no2_ug_m3"
)

data_palangka <- data_palangka %>%
  mutate(across(
    all_of(kolom_polutan),
    ~ parse_number(as.character(.x))
  ))

data_sampit <- data_sampit %>%
  mutate(across(
    all_of(kolom_polutan),
    ~ parse_number(as.character(.x))
  ))

data_dua_stasiun <- bind_rows(
  data_palangka %>% mutate(stasiun = "Palangka Raya"),
  data_sampit %>% mutate(stasiun = "Sampit")
)

data_perbandingan <- data_dua_stasiun %>%
  mutate(
    waktu = lubridate::ymd_hms(timestamp_start),
    tanggal = as.Date(waktu),
    periode = if_else(
      tanggal == as.Date("2026-10-14"),
      "14 Oktober",
      "10-13 Oktober"
    )
  ) %>%
  filter(
    tanggal >= as.Date("2026-10-10"),
    tanggal <= as.Date("2026-10-14"),
    qc_flag == "VALID"
  )

hasil_perbandingan <- data_perbandingan %>%
  group_by(stasiun, periode) %>%
  summarise(
    across(
      all_of(kolom_polutan),
      ~ mean(.x, na.rm = TRUE)
    ),
    .groups = "drop"
  )

print(hasil_perbandingan, width = Inf)


