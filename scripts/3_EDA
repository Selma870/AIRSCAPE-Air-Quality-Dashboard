data_gas_ppm <- purrr::imap_dfr(
  data_aqms_list,
  function(.x, .y) {
    
    if (all(c("so2_ppm", "no2_ppm") %in% names(.x))) {
      
      .x %>%
        select(
          sensor_id,
          timestamp_start,
          so2_ppm,
          no2_ppm,
          qc_flag
        ) %>%
        mutate(stasiun = .y)
      
    } else {
      NULL
    }
  }
)

