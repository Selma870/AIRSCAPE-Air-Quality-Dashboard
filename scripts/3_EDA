library(dplyr)
library(tidyr)
library(lubridate)

# 1. Siapkan data PM2.5
pm25_lag <- data_pm25 %>%
  mutate(tanggal = as.Date(
    parse_date_time(as.character(tanggal),
                    orders = c("ymd", "dmy", "mdy"))
  )) %>%
  group_by(tanggal) %>%
  summarise(
    pm25 = mean(rata_rata_polusi, na.rm = TRUE),
    resp = mean(resp, na.rm = TRUE),
    .groups = "drop"
  )

# 2. Siapkan data CO
co_lag <- data_co %>%
  mutate(tanggal = as.Date(
    parse_date_time(as.character(tanggal),
                    orders = c("ymd", "dmy", "mdy"))
  )) %>%
  group_by(tanggal) %>%
  summarise(
    co = mean(rata_rata_polusi, na.rm = TRUE),
    .groups = "drop"
  )

# 3. Gabungkan berdasarkan tanggal
data_lag <- pm25_lag %>%
  select(tanggal, resp, pm25) %>%
  full_join(co_lag, by = "tanggal") %>%
  complete(
    tanggal = seq(
      min(tanggal, na.rm = TRUE),
      max(tanggal, na.rm = TRUE),
      by = "day"
    )
  ) %>%
  arrange(tanggal)

# 4. Hitung korelasi setiap lag
lag_list <- c(0, 1, 2, 3, 7)

hasil_lag <- lapply(lag_list, function(k) {
  
  data_lag %>%
    mutate(
      resp_lag = lead(resp, k)
    ) %>%
    summarise(
      lag = k,
      pm25_rho = cor(pm25, resp_lag,
                     method = "spearman",
                     use = "complete.obs"),
      co_rho = cor(co, resp_lag,
                   method = "spearman",
                   use = "complete.obs"),
      jumlah_data = sum(complete.cases(pm25, co, resp_lag))
    )
}) %>%
  bind_rows()

print(hasil_lag)

write.csv(
  hasil_lag,
  "OUTPUT/hasil_analisis_lag.csv",
  row.names = FALSE
)

