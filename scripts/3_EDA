  ) %>%
  group_by(tanggal) %>%
  summarise(
    rata_rata = mean(nilai_rata_rata, na.rm = TRUE),
    median_stasiun = median(nilai_rata_rata, na.rm = TRUE),
    minimum = min(nilai_rata_rata, na.rm = TRUE),
    maksimum = max(nilai_rata_rata, na.rm = TRUE),
    jumlah_stasiun = n_distinct(stasiun),
    .groups = "drop"
  )

