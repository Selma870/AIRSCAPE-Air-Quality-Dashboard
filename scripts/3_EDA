# Audit header satuan PM2.5 seluruh stasiun
audit_satuan_pm25 <- tibble(
  stasiun = names(data_aqms_list),
  header_pm25 = map_chr(
    data_aqms_list,
    ~ {
      kolom <- names(.x)
      hasil <- kolom[grepl("^pm25_", kolom, ignore.case = TRUE)]
      
      if (length(hasil) == 0) {
        "Tidak ditemukan"
      } else {
        paste(hasil, collapse = ", ")
      }
    }
  )
)

print(audit_satuan_pm25, n = Inf)

# Identifikasi stasiun yang menggunakan header ppm
stasiun_ppm <- audit_satuan_pm25 %>%
  filter(grepl("ppm", header_pm25))

# Ambil sensor ID dari masing-masing stasiun
sensor_ppm <- purrr::imap_dfr(
  data_aqms_list,
  ~ {
    if ("pm25_ppm" %in% names(.x)) {
      .x %>%
        distinct(sensor_id) %>%
        mutate(stasiun = .y)
    }
  }
)

