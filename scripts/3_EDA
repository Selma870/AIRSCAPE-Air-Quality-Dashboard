library(dplyr)
library(lubridate)

pm25_per_stasiun <- data_aqms_clean %>%
  filter(
    qc_flag == "VALID",
    as.Date(timestamp_start) >= as.Date("2024-01-01"),
    as.Date(timestamp_start) <= as.Date("2026-10-14")
  ) %>%
  group_by(stasiun) %>%
  summarise(
    rata_rata_pm25 = if (all(is.na(pm25_ug_m3))) {
      NA_real_
    } else {
      mean(pm25_ug_m3, na.rm = TRUE)
    },
    jumlah_pengamatan = sum(!is.na(pm25_ug_m3)),
    .groups = "drop"
  )

print(pm25_per_stasiun)
pm25_per_stasiun <- pm25_per_stasiun %>%
  mutate(kode_stasiun = sub("_.*", "", stasiun))

sites_peta <- sites %>%
  mutate(kode_stasiun = sub("^AQMS-", "", station_code))

peta_pm25 <- pm25_per_stasiun %>%
  left_join(
    sites_peta,
    by = "kode_stasiun"
  ) %>%
  mutate(
    kategori_udara = case_when(
      is.na(rata_rata_pm25) ~ "Tidak tersedia",
      TRUE ~ "Belum dikategorikan"
    )
  ) %>%
  select(
    stasiun,
    station_code,
    provinsi,
    kota_kabupaten,
    latitude_dd,
    longitude_dd,
    rata_rata_pm25,
    jumlah_pengamatan,
    kategori_udara,
    pm25_unit
  )

print(peta_pm25, n = 27)
write.csv(
  peta_pm25,
  "OUTPUT/peta_pm25_per_stasiun.csv",
  row.names = FALSE
)
