data_bjb <- data_aqms_list[["BJB-01_Banjarbaru_AQMS"]] %>%
  mutate(
    pm25_num = as.numeric(pm25_ppm),
    tanggal = as.Date(timestamp_start)
  ) %>%
  filter(qc_flag == "VALID")

# Frekuensi nilai PM2.5 per bulan
pola_bjb <- data_bjb %>%
  mutate(
    bulan = format(tanggal, "%Y-%m")
  ) %>%
  group_by(bulan) %>%
  summarise(
    jumlah_data = n(),
    jumlah_0337 = sum(pm25_num == 0.3367, na.rm = TRUE),
    jumlah_00035 = sum(pm25_num == 0.0035, na.rm = TRUE),
    rata_rata = mean(pm25_num, na.rm = TRUE),
    median = median(pm25_num, na.rm = TRUE),
    .groups = "drop"
  )

print(pola_bjb, n = Inf)

