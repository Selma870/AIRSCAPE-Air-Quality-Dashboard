library(dplyr)
library(tidyr)
library(purrr)
library(readr)

kolom_gas <- c(
  "so2_ug_m3", "so2_ppm",
  "no2_ug_m3", "no2_ppm"
)

audit_nilai_gas <- imap_dfr(
  data_aqms_list,
  function(x, nama_stasiun) {
    
    kolom_ada <- intersect(kolom_gas, names(x))
    
    x %>%
      mutate(stasiun = nama_stasiun) %>%
      select(stasiun, qc_flag, all_of(kolom_ada)) %>%
      pivot_longer(
        cols = all_of(kolom_ada),
        names_to = "parameter",
        values_to = "nilai_asli"
      ) %>%
      mutate(
        nilai_asli = as.character(nilai_asli),
        nilai_angka = suppressWarnings(
          as.numeric(nilai_asli)
        )
      ) %>%
      filter(
        !is.na(nilai_asli),
        trimws(nilai_asli) != "",
        is.na(nilai_angka) |
          !is.finite(nilai_angka)
      ) %>%
      count(
        stasiun, parameter, qc_flag, nilai_asli,
        name = "frekuensi"
      )
  }
)

print(audit_nilai_gas, n = Inf)


