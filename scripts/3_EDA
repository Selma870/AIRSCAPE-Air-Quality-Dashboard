ringkasan_kualitas_27 <- data_gas_27 %>%
  mutate(
    waktu = ymd_hms(timestamp_start, quiet = TRUE),
    waktu_valid = !is.na(waktu) &
      as.Date(waktu) >= as.Date("2024-01-01") &
      as.Date(waktu) <= as.Date("2026-10-14")
  ) %>%
  group_by(stasiun) %>%
  summarise(
    total_data = n(),
    
    data_lolos = sum(
      qc_flag == "VALID" &
        waktu_valid &
        !is.na(so2_ug_m3) &
        !is.na(no2_ug_m3) &
        so2_ug_m3 >= 0 &
        no2_ug_m3 >= 0,
      na.rm = TRUE
    ),
    
    persentase_lolos = data_lolos / total_data * 100,
    
    .groups = "drop"
  ) %>%
  arrange(persentase_lolos)

print(ringkasan_kualitas_27, n = Inf)

audit_interval_27 <- data_gas_27 %>%
  mutate(
    waktu = ymd_hms(timestamp_start, quiet = TRUE)
  ) %>%
  filter(
    qc_flag == "VALID",
    !is.na(waktu),
    as.Date(waktu) >= as.Date("2024-01-01"),
    as.Date(waktu) <= as.Date("2026-10-14")
  ) %>%
  arrange(stasiun, sensor_id, waktu) %>%
  group_by(stasiun, sensor_id) %>%
  mutate(
    selisih_menit = as.numeric(
      difftime(waktu, lag(waktu), units = "mins")
    )
  ) %>%
  filter(!is.na(selisih_menit)) %>%
  summarise(
    interval_15_menit = sum(selisih_menit == 15),
    interval_60_menit = sum(selisih_menit == 60),
    interval_lainnya = sum(
      selisih_menit != 15 & selisih_menit != 60
    ),
    median_interval = median(selisih_menit),
    .groups = "drop"
  )

print(audit_interval_27, n = Inf)

audit_detail_interval <- data_gas_27 %>%
  mutate(
    waktu = ymd_hms(timestamp_start, quiet = TRUE)
  ) %>%
  filter(
    qc_flag == "VALID",
    !is.na(waktu),
    as.Date(waktu) >= as.Date("2024-01-01"),
    as.Date(waktu) <= as.Date("2026-10-14")
  ) %>%
  arrange(stasiun, sensor_id, waktu) %>%
  group_by(stasiun, sensor_id) %>%
  mutate(
    selisih_menit = as.numeric(
      difftime(waktu, lag(waktu), units = "mins")
    )
  ) %>%
  filter(!is.na(selisih_menit)) %>%
  summarise(
    interval_15 = sum(selisih_menit == 15),
    interval_60 = sum(selisih_menit == 60),
    interval_lebih_60 = sum(selisih_menit > 60),
    interval_kurang_60 = sum(
      selisih_menit < 60 & selisih_menit != 15
    ),
    jeda_lebih_24_jam = sum(selisih_menit > 1440),
    median_interval = median(selisih_menit),
    maksimum_jeda = max(selisih_menit),
    .groups = "drop"
  )

print(audit_detail_interval, n = Inf)


audit_detail_interval %>%
  select(
    stasiun,
    interval_15,
    interval_60,
    interval_lebih_60,
    interval_kurang_60,
    jeda_lebih_24_jam,
    median_interval,
    maksimum_jeda
  ) %>%
  arrange(desc(maksimum_jeda)) %>%
  print(n = Inf, width = Inf)

audit_jeda_panjang <- data_gas_27 %>%
  mutate(
    waktu = ymd_hms(timestamp_start, quiet = TRUE)
  ) %>%
  filter(
    qc_flag == "VALID",
    !is.na(waktu),
    as.Date(waktu) >= as.Date("2024-01-01"),
    as.Date(waktu) <= as.Date("2026-10-14")
  ) %>%
  arrange(stasiun, sensor_id, waktu) %>%
  group_by(stasiun, sensor_id) %>%
  mutate(
    waktu_sebelumnya = lag(waktu),
    jeda_jam = as.numeric(
      difftime(waktu, waktu_sebelumnya, units = "hours")
    )
  ) %>%
  filter(jeda_jam > 24) %>%
  ungroup() %>%
  select(
    stasiun,
    sensor_id,
    waktu_sebelumnya,
    waktu,
    jeda_jam
  ) %>%
  arrange(desc(jeda_jam))

print(audit_jeda_panjang, n = 50, width = Inf)

library(purrr)
library(dplyr)
library(lubridate)

# Mengubah timestamp data mentah
data_gas_27_waktu <- data_gas_27 %>%
  mutate(
    waktu = ymd_hms(timestamp_start, quiet = TRUE)
  )

# Ambil 20 kejadian jeda terpanjang
jeda_20_terpanjang <- audit_jeda_panjang %>%
  slice_max(jeda_jam, n = 20, with_ties = FALSE)

# Periksa seluruh status QC dalam setiap jeda
audit_status_jeda <- map_dfr(
  seq_len(nrow(jeda_20_terpanjang)),
  function(i) {
    
    awal <- jeda_20_terpanjang$waktu_sebelumnya[i]
    akhir <- jeda_20_terpanjang$waktu[i]
    stasiun_i <- jeda_20_terpanjang$stasiun[i]
    sensor_i <- jeda_20_terpanjang$sensor_id[i]
    
    data_gas_27_waktu %>%
      filter(
        stasiun == stasiun_i,
        sensor_id == sensor_i,
        waktu > awal,
        waktu <= akhir
      ) %>%
      count(qc_flag, name = "jumlah_baris") %>%
      mutate(
        stasiun = stasiun_i,
        waktu_awal = awal,
        waktu_akhir = akhir,
        jeda_jam = jeda_20_terpanjang$jeda_jam[i]
      )
  }
)

print(audit_status_jeda, n = Inf, width = Inf)

audit_status_seluruh <- data_gas_27 %>%
  count(stasiun, qc_flag, name = "jumlah_baris") %>%
  group_by(stasiun) %>%
  mutate(
    total_baris = sum(jumlah_baris),
    persentase = jumlah_baris / total_baris * 100
  ) %>%
  ungroup() %>%
  arrange(stasiun, desc(persentase))

print(audit_status_seluruh, n = Inf)
ringkasan_status_bermasalah <- audit_status_seluruh %>%
  filter(qc_flag != "VALID") %>%
  group_by(qc_flag) %>%
  summarise(
    jumlah_total = sum(jumlah_baris),
    jumlah_stasiun = n_distinct(stasiun),
    .groups = "drop"
  ) %>%
  arrange(desc(jumlah_total))

print(ringkasan_status_bermasalah, n = Inf)


klasifikasi_stasiun <- ringkasan_kualitas_27 %>%
  mutate(
    kategori_kualitas = case_when(
      persentase_lolos >= 95 ~ "Sangat tinggi",
      persentase_lolos >= 75 ~ "Menengah",
      persentase_lolos >= 25 ~ "Rendah",
      TRUE ~ "Sangat rendah"
    ),
    rekomendasi_awal = case_when(
      persentase_lolos >= 95 ~ "Kandidat analisis utama",
      persentase_lolos >= 75 ~ "Analisis dengan catatan",
      TRUE ~ "Tidak digunakan sebagai analisis utama"
    )
  ) %>%
  arrange(persentase_lolos)

print(klasifikasi_stasiun, n = Inf)

