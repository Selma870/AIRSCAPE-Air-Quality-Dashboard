library(dplyr)
library(tidyr)

# 1. Fungsi agregasi harian untuk satu kelompok satuan
buat_agregasi_harian <- function(data, kolom, satuan) {
  
  hasil <- data %>%
    mutate(tanggal = as.Date(tanggal)) %>%
    filter(
      !is.na(tanggal),
      tanggal >= as.Date("2024-01-01"),
      tanggal <= as.Date("2026-10-14")
    ) %>%
    group_by(stasiun, tanggal) %>%
    summarise(
      across(
        all_of(kolom),
        list(
          mean = ~ if (all(is.na(.x))) NA_real_
          else mean(.x, na.rm = TRUE),
          n = ~ sum(!is.na(.x))
        ),
        .names = "{.col}_{.fn}"
      ),
      .groups = "drop"
    ) %>%
    pivot_longer(
      cols = -c(stasiun, tanggal),
      names_to = c("polutan", ".value"),
      names_pattern = "(.*)_(mean|n)"
    ) %>%
    mutate(
      polutan = sub(paste0("_", satuan, "$"), "", polutan),
      satuan = satuan
    ) %>%
    rename(
      nilai_rata_rata = mean,
      jumlah_pengamatan = n
    ) %>%
    filter(jumlah_pengamatan > 0)
  
  return(hasil)
}

# 2. Kolom polutan dengan satuan ug/m3
kolom_ug <- c(
  "pm25_ug_m3", "pm10_ug_m3",
  "so2_ug_m3", "no2_ug_m3",
  "co_ug_m3", "o3_ug_m3"
)

# 3. Kolom polutan dengan satuan ppm
kolom_ppm <- c(
  "pm25_ppm", "pm10_ppm",
  "so2_ppm", "no2_ppm",
  "co_ppm", "o3_ppm"
)

# 4. Buat agregasi masing-masing satuan
data_harian_ug <- buat_agregasi_harian(
  data_aqms_clean, kolom_ug, "ug_m3"
)

data_harian_ppm <- buat_agregasi_harian(
  data_aqms_clean, kolom_ppm, "ppm"
)

# 5. Gabungkan hasil tanpa mencampur satuan
data_harian_final <- bind_rows(
  data_harian_ug,
  data_harian_ppm
) %>%
  arrange(tanggal, stasiun, polutan)

