# Faktor konversi ppm ke ug/m3
# Asumsi suhu 25 C dan tekanan 1 atm
faktor_so2 <- (64.066 * 1000) / 24.45
faktor_no2 <- (46.0055 * 1000) / 24.45

# Fungsi untuk mengambil kolom numerik
ambil_angka <- function(data, kolom) {
  if (kolom %in% names(data)) {
    parse_number(as.character(data[[kolom]]))
  } else {
    rep(NA_real_, nrow(data))
  }
}

# Menggabungkan seluruh 27 file AQMS
data_gas_27 <- purrr::imap_dfr(
  data_aqms_list,
  function(x, nama_stasiun) {
    
    # Ambil SO2
    if ("so2_ug_m3" %in% names(x)) {
      so2 <- ambil_angka(x, "so2_ug_m3")
    } else {
      so2 <- ambil_angka(x, "so2_ppm") * faktor_so2
    }
    
    # Ambil NO2
    if ("no2_ug_m3" %in% names(x)) {
      no2 <- ambil_angka(x, "no2_ug_m3")
    } else {
      no2 <- ambil_angka(x, "no2_ppm") * faktor_no2
    }
    
    tibble(
      stasiun = nama_stasiun,
      sensor_id = as.character(x$sensor_id),
      timestamp_start = as.character(x$timestamp_start),
      qc_flag = as.character(x$qc_flag),
      so2_ug_m3 = so2,
      no2_ug_m3 = no2
    )
  }
)

