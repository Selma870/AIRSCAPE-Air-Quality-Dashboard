  group_by(stasiun, periode) %>%
  summarise(
    PM25 = mean(pm25_ug_m3, na.rm = TRUE),
    PM10 = mean(pm10_ug_m3, na.rm = TRUE),
    SO2 = mean(so2_ug_m3, na.rm = TRUE),
    CO = mean(co_ug_m3, na.rm = TRUE),
    O3 = mean(o3_ug_m3, na.rm = TRUE),
    NO2 = mean(no2_ug_m3, na.rm = TRUE),
    Suhu = mean(temperature_c, na.rm = TRUE),
    Kelembapan = mean(humidity_pct, na.rm = TRUE),
    .groups = "drop"
  )

