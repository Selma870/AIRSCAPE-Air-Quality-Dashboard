# MEMBANDINGKAN HASIL EPISODE MEAN DAN MEDIAN

hasil_perbandingan <- bind_rows(
  pm25_episode %>%
    summarise(
      metode = "Mean",
      jumlah_episode = n(),
      durasi_terpanjang = max(durasi_hari),
      rata_rata_durasi = mean(durasi_hari),
      puncak_tertinggi = max(konsentrasi_puncak)
    ),
  
  pm25_episode_median %>%
    summarise(
      metode = "Median",
      jumlah_episode = n(),
      durasi_terpanjang = max(durasi_hari),
      rata_rata_durasi = mean(durasi_hari),
      puncak_tertinggi = max(median_puncak)
    )
)

print(hasil_perbandingan)
