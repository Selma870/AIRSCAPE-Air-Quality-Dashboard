# Data PM2.5
data_pm25 <- aqms_health_join %>%
  filter(polutan == "pm25", satuan == "ug_m3")

# Data CO
data_co <- aqms_health_join %>%
  filter(polutan == "co", satuan == "ug_m3")

# Korelasi PM2.5 dengan resp
cor.test(
  data_pm25$rata_rata_polusi,
  data_pm25$resp,
  method = "spearman",
  exact = FALSE
)

# Korelasi CO dengan resp
cor.test(
  data_co$rata_rata_polusi,
  data_co$resp,
  method = "spearman",
  exact = FALSE
)

# PM2.5 dengan asthma
cor.test(
  data_pm25$rata_rata_polusi,
  data_pm25$asthma_emergency_cases,
  method = "spearman",
  exact = FALSE
)

# PM2.5 dengan COPD
cor.test(
  data_pm25$rata_rata_polusi,
  data_pm25$copd_admissions,
  method = "spearman",
  exact = FALSE
)

# CO dengan asthma
cor.test(
  data_co$rata_rata_polusi,
  data_co$asthma_emergency_cases,
  method = "spearman",
  exact = FALSE
)

# CO dengan COPD
cor.test(
  data_co$rata_rata_polusi,
  data_co$copd_admissions,
  method = "spearman",
  exact = FALSE
)


