# Ringkasan PM2.5 berdasarkan QC

for (stasiun in stasiun_masalah) {
  
  cat("\nSTASIUN:", stasiun, "\n")
  
  data_aqms_list[[stasiun]] %>%
    mutate(
      pm25_num = as.numeric(pm25_ppm)
    ) %>%
    group_by(qc_flag) %>%
    summarise(
      jumlah = n(),
      
      rata_rata = if (all(is.na(pm25_num))) NA_real_
      else mean(pm25_num, na.rm = TRUE),
      
      median = if (all(is.na(pm25_num))) NA_real_
      else median(pm25_num, na.rm = TRUE),
      
      maksimum = if (all(is.na(pm25_num))) NA_real_
      else max(pm25_num, na.rm = TRUE),
      
      .groups = "drop"
    ) %>%
    print(n = Inf)
}

for (stasiun in stasiun_masalah) {
  
  cat("\nSTASIUN:", stasiun, "\n")
  
  data_aqms_list[[stasiun]] %>%
    mutate(
      pm25_num = as.numeric(pm25_ppm)
    ) %>%
    filter(
      qc_flag == "VALID",
      !is.na(pm25_num)
    ) %>%
    arrange(desc(pm25_num)) %>%
    select(
      timestamp_start,
      pm25_num,
      qc_flag
    ) %>%
    print(n = 10)
}
