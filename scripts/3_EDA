# Faktor konversi pada 25 derajat C dan 1 atm

faktor_so2 <- (64.066 * 1000) / 24.45
faktor_no2 <- (46.0055 * 1000) / 24.45

# Konversi ppm ke ug/m3

data_gas_iku <- data_gas_valid %>%
  mutate(
    so2_ug_m3 = so2_ppm * faktor_so2,
    no2_ug_m3 = no2_ppm * faktor_no2
  )

# Ringkasan konsentrasi hasil konversi

ringkasan_gas_iku <- data_gas_iku %>%
  group_by(stasiun) %>%
  summarise(
    SO2_mean = mean(so2_ug_m3, na.rm = TRUE),
    NO2_mean = mean(no2_ug_m3, na.rm = TRUE),
    .groups = "drop"
  )

print(ringkasan_gas_iku, n = Inf)

