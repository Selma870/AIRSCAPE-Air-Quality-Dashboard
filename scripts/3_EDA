# 1. Tentukan variabel yang akan diperiksa
variabel_aqms <- c(
  "pm25_ppm",
  "pm10_ppm",
  "so2_ppm",
  "co_ppm",
  "o3_ppm",
  "no2_ppm",
  "temperature_c",
  "humidity_pct",
  "wind_speed_ms",
  "wind_direction_deg"
)

# 2. Ambil periode anomali PM2.5
periode_bjb <- bjb_audit %>%
  filter(
    waktu >= lubridate::ymd_hms("2024-09-07 00:01:15"),
    waktu <= lubridate::ymd_hms("2025-03-29 13:01:16")
  ) %>%
  mutate(
    across(
      all_of(variabel_aqms),
      ~ as.numeric(.x)
    )
  )

# 3. Periksa variasi setiap parameter
hasil_pemeriksaan_bjb <- periode_bjb %>%
  summarise(
    across(
      all_of(variabel_aqms),
      list(
        jumlah_unik = ~ n_distinct(.x, na.rm = TRUE),
        minimum = ~ min(.x, na.rm = TRUE),
        maksimum = ~ max(.x, na.rm = TRUE),
        standar_deviasi = ~ sd(.x, na.rm = TRUE)
      )
    )
  )

print(hasil_pemeriksaan_bjb, width = Inf)

bjb_audit %>%
  mutate(
    periode = case_when(
      waktu < lubridate::ymd_hms("2024-09-07 00:01:15") ~ "Sebelum",
      waktu <= lubridate::ymd_hms("2025-03-29 13:01:16") ~ "Selama",
      TRUE ~ "Sesudah"
    )
  ) %>%
  group_by(periode) %>%
  summarise(
    jumlah_data = n(),
    PM25_unik = n_distinct(pm25_num, na.rm = TRUE),
    PM25_min = min(pm25_num, na.rm = TRUE),
    PM25_max = max(pm25_num, na.rm = TRUE),
    PM25_sd = sd(pm25_num, na.rm = TRUE),
    .groups = "drop"
  )


hasil_anomali_semua <- purrr::imap_dfr(
  data_aqms_list,
  function(data, nama_stasiun) {
    
    kolom_pm <- intersect(
      c("pm25_ug_m3", "pm25_ppm"),
      names(data)
    )[1]
    
    if (is.na(kolom_pm)) return(NULL)
    
    nilai <- as.numeric(data[[kolom_pm]])
    
    tibble(
      station_file = nama_stasiun,
      satuan_kolom = kolom_pm,
      jumlah_data = sum(!is.na(nilai)),
      jumlah_nilai_unik = n_distinct(nilai, na.rm = TRUE),
      minimum = min(nilai, na.rm = TRUE),
      maksimum = max(nilai, na.rm = TRUE),
      standar_deviasi = sd(nilai, na.rm = TRUE)
    )
  }
)

hasil_anomali_semua %>%
  arrange(standar_deviasi) %>%
  print(n = Inf)

library(dplyr)
library(purrr)
library(tibble)

audit_pm25_lanjutan <- imap_dfr(
  data_aqms_list,
  function(data, nama_stasiun) {
    
    kolom_pm <- intersect(
      c("pm25_ug_m3", "pm25_ppm"),
      names(data)
    )[1]
    
    if (is.na(kolom_pm)) return(NULL)
    
    nilai_asli <- data[[kolom_pm]]
    nilai <- suppressWarnings(as.numeric(nilai_asli))
    
    tibble(
      stasiun = nama_stasiun,
      satuan = kolom_pm,
      total_data = length(nilai),
      missing_asli = sum(is.na(nilai_asli)),
      gagal_konversi = sum(
        !is.na(nilai_asli) & is.na(nilai)
      ),
      nilai_inf = sum(is.infinite(nilai), na.rm = TRUE),
      nilai_negatif = sum(
        nilai < 0 & is.finite(nilai),
        na.rm = TRUE
      ),
      jumlah_nilai_unik = n_distinct(
        nilai[is.finite(nilai)]
      ),
      minimum = if (any(is.finite(nilai))) {
        min(nilai[is.finite(nilai)])
      } else NA_real_,
      maksimum = if (any(is.finite(nilai))) {
        max(nilai[is.finite(nilai)])
      } else NA_real_
    )
  }
)

audit_pm25_lanjutan %>%
  print(n = Inf, width = Inf)

