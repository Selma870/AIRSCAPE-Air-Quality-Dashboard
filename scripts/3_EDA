data_perbandingan <- data_dua_stasiun %>%
  mutate(
    waktu = ymd_hms(timestamp_start),
    tanggal = as.Date(waktu),
    periode = if_else(
      tanggal == as.Date("2026-10-14"),
      "14 Oktober",
      "10-13 Oktober"
    )
  ) %>%
  filter(
    tanggal >= as.Date("2026-10-10"),
    tanggal <= as.Date("2026-10-14"),
    qc_flag == "VALID"
  )

# Ringkasan seluruh parameter
