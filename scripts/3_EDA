data_aqms_clean <- imap_dfr(
  data_aqms_list,
  function(data, nama) {
    
    data %>%
      filter(trimws(qc_flag) == "VALID") %>%
      mutate(
        across(
          any_of(kolom_polutan),
          ~ parse_number(as.character(.x))
        ),
        stasiun = nama
      )
  }
)

