library(dplyr)
library(lubridate)

pola_berulang_bjb <- data_aqms_list[["BJB-01_Banjarbaru_AQMS"]] %>%
  mutate(
    pm25_num = as.numeric(pm25_ppm),
    waktu = ymd_hms(timestamp_start)
  ) %>%
  filter(
    qc_flag == "VALID",
    !is.na(pm25_num)
  ) %>%
  arrange(waktu) %>%
  mutate(
    nilai_sama = pm25_num == lag(pm25_num),
    kelompok = cumsum(
      is.na(nilai_sama) | !nilai_sama
    )
  ) %>%
  group_by(kelompok, pm25_num) %>%
  summarise(
    waktu_awal = min(waktu),
    waktu_akhir = max(waktu),
    jumlah_pengamatan = n(),
    durasi_jam = as.numeric(
      difftime(max(waktu), min(waktu), units = "hours")
    ),
    .groups = "drop"
  ) %>%
  filter(jumlah_pengamatan >= 6) %>%
  arrange(desc(jumlah_pengamatan))

print(pola_berulang_bjb, n = 30)

