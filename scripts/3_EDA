library(dplyr)
library(purrr)
library(tidyr)

daftar_polutan <- list(
  PM25 = c("pm25_ug_m3", "pm25_ppm"),
  PM10 = c("pm10_ug_m3", "pm10_ppm"),
  SO2  = c("so2_ug_m3", "so2_ppm"),
  NO2  = c("no2_ug_m3", "no2_ppm"),
  CO   = c("co_ug_m3", "co_ppm"),
  O3   = c("o3_ug_m3", "o3_ppm")
)

audit_missing_polutan <- imap_dfr(
  data_aqms_list,
  function(data, nama_stasiun) {
    
    map_dfr(names(daftar_polutan), function(polutan) {
      
      kolom <- intersect(
        daftar_polutan[[polutan]],
        names(data)
      )
      
      if (length(kolom) == 0) {
        return(tibble(
          stasiun = nama_stasiun,
          polutan = polutan,
          nama_kolom = NA_character_,
          satuan = NA_character_,
          total_data = nrow(data),
          missing = NA_integer_,
          persen_missing = NA_real_
        ))
      }
      
      tibble(
        stasiun = nama_stasiun,
        polutan = polutan,
        nama_kolom = kolom[1],
        satuan = ifelse(
          grepl("_ppm$", kolom[1]),
          "ppm",
          "ug/m3"
        ),
        total_data = nrow(data),
        missing = sum(is.na(data[[kolom[1]]])),
        persen_missing =
          mean(is.na(data[[kolom[1]]])) * 100
      )
    })
  }
)

print(audit_missing_polutan, n = Inf)

audit_kode_khusus <- imap_dfr(
  data_aqms_list,
  function(data, nama_stasiun) {
    
    kolom_polutan <- intersect(
      unlist(daftar_polutan),
      names(data)
    )
    
    map_dfr(kolom_polutan, function(kolom) {
      
      tibble(
        stasiun = nama_stasiun,
        polutan = kolom,
        jumlah_minus99 = sum(data[[kolom]] == -99, na.rm = TRUE),
        jumlah_minus9999 = sum(data[[kolom]] == -9999, na.rm = TRUE),
        jumlah_50000 = sum(data[[kolom]] == 50000, na.rm = TRUE),
        jumlah_8888 = sum(data[[kolom]] == 8888, na.rm = TRUE),
        jumlah_nol = sum(data[[kolom]] == 0, na.rm = TRUE)
      )
    })
  }
)

print(
  audit_kode_khusus %>%
    filter(
      if_any(
        starts_with("jumlah_"),
        ~ .x > 0
      )
    ),
  n = Inf
)

