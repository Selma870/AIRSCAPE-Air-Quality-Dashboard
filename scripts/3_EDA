# Korelasi PM2.5 dengan intensitas lalu lintas
cor_traffic <- cor.test(
  data_spasial$rata_pm25,
  data_spasial$traffic_intensity_per_h,
  method = "spearman",
  exact = FALSE
)

print(cor_traffic)


# Korelasi PM2.5 dengan jarak jalan
cor_road <- cor.test(
  data_spasial$rata_pm25,
  data_spasial$distance_to_road_m,
  method = "spearman",
  exact = FALSE
)

print(cor_road)


# Korelasi PM2.5 dengan baseline PM2.5
cor_baseline <- cor.test(
  data_spasial$rata_pm25,
  data_spasial$baseline_pm25,
  method = "spearman",
  exact = FALSE
)

print(cor_baseline)


