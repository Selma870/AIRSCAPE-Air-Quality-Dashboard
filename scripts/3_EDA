ringkasan_qc_gas <- data_gas_ppm %>%
  group_by(stasiun) %>%
  summarise(
    total_data = n(),
    
    valid = sum(qc_flag == "VALID", na.rm = TRUE),
    
    suspect = sum(qc_flag == "SUSPECT", na.rm = TRUE),
    
    warmup = sum(qc_flag == "WARMUP", na.rm = TRUE),
    
    calibration = sum(qc_flag == "CALIBRATING", na.rm = TRUE),
    
    missing_qc = sum(is.na(qc_flag)),
    
    persentase_valid = valid / total_data * 100,
    
    .groups = "drop"
  )

print(ringkasan_qc_gas, n = Inf)
